{
  "$schema": "https://opencode.ai/config.json",
  "model": "genai/gemini-2.5-flash",
  "provider": {
    "genai": {
      "npm": "@ai-sdk/openai",
      "name": "GenAI (stark-proxy)",
      "options": {
        "baseURL": "https://api.genai.mil/v1",
        "apiKey": "{env:GENAI_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash",
          "limit": { "context": 2000000, "output": 8192 }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "limit": { "context": 2000000, "output": 8192 }
        }
      }
    }
  }
}
